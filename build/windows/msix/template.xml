<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="unityperfagent.exe"
        Arguments=""
        InstallLocation="C:\Program Files\UnityPerfAgent\UnityPerfAgent">
    </Installer>
    <PackageInformation
        PackageName="UnityPerfAgent"
        PackageDisplayName="UnityPerfAgent"
        PublisherName="CN=UnityPerfAgent"
        PublisherDisplayName="UnityPerfAgent"
        Version="0.1.0.0"
        PackageDescription="Standalone Unity performance analysis tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.unityperfagent.app"
                Description="Standalone Unity performance analysis tool"
                DisplayName="UnityPerfAgent"
                ExecutableName="unityperfagent.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>UnityPerfAgent</DisplayName>
            <PublisherDisplayName>UnityPerfAgent</PublisherDisplayName>
            <Description>Standalone Unity performance analysis tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="unityperfagent.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
